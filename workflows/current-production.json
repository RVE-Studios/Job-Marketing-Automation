        0
      ],
      "id": "4ea535f4-300b-4a93-ae5e-79ae07ff094b",
      "name": "HTTP Request",
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "credentials": {
        "anthropicApi": {
          "id": "kZC23F2ETYwfil57",
          "name": "Anthropic account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst parseNode = $('Parse Data').all();\nconst results = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const response = items[i].json;\n  const inputData = parseNode[i].json;\n  \n  try {\n    // Extract content\n    let content = response.content[0].text;\n    content = content.replace(/```json\\n?/g, '').replace(/```/g, '').trim();\n    const generated = JSON.parse(content);\n    \n    // Cost tracking\n    const usage = response.usage || {};\n    const inputTokens = usage.input_tokens || 0;\n    const outputTokens = usage.output_tokens || 0;\n    const estimatedCost = (inputTokens * 0.000003) + (outputTokens * 0.000015);\n    \n    // Quality validation\n    const h1 = generated.headline_1 || '';\n    const h2 = generated.headline_2 || '';\n    const h3 = generated.headline_3 || '';\n    \n    const qualityIssues = [];\n    if (h1.length > 80) qualityIssues.push('H1 too long');\n    if (h2.length > 80) qualityIssues.push('H2 too long');\n    if (h3.length > 80) qualityIssues.push('H3 too long');\n    \n    const genericPhrases = ['great opportunity', 'join our team', 'we are looking'];\n    [h1, h2, h3].forEach((headline, i) => {\n      genericPhrases.forEach(phrase => {\n        if (headline.toLowerCase().includes(phrase)) {\n          qualityIssues.push(`H${i+1}: generic phrase \"${phrase}\"`);\n        }\n      });\n    });\n    \n    results.push({\n      json: {\n        recordId: inputData.recordId,\n        status: qualityIssues.length > 0 ? 'Review' : 'Done',\n        headline1: h1,\n        headline2: h2,\n        headline3: h3,\n        adCopy1: generated.ad_copy_1 || '',\n        adCopy2: generated.ad_copy_2 || '',\n        targeting: JSON.stringify(generated.targeting, null, 2),\n        generatedAt: new Date().toISOString(),\n        tokensUsed: inputTokens + outputTokens,\n        estimatedCost: `$${estimatedCost.toFixed(4)}`,\n        qualityIssues: qualityIssues.join(' | '),\n        errorLog: ''\n      }\n    });\n  } catch (error) {\n    results.push({\n      json: {\n        recordId: inputData.recordId,\n        status: 'Error',\n        headline1: '',\n        headline2: '',\n        headline3: '',\n        adCopy1: '',\n        adCopy2: '',\n        targeting: '',\n        generatedAt: new Date().toISOString(),\n        tokensUsed: 0,\n        estimatedCost: '$0.0000',\n        qualityIssues: '',\n        errorLog: error.message\n      }\n    });\n  }\n}\n\nreturn results;"
      },
