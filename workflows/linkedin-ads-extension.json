      "parameters": {
        "jsCode": "/**\n * Error handler for LinkedIn Ads API failures\n * Updates Airtable with error details\n */\n\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const errorData = {\n    recordId: item.json.recordId || 'unknown',\n    campaignStatus: 'API Error',\n    errorLog: `LinkedIn Ads API Error: ${item.json.error || 'Unknown error'}`,\n    campaignCreatedAt: new Date().toISOString()\n  };\n  \n  results.push({ json: errorData });\n}\n\nreturn results;"
      },
